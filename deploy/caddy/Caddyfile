# Dawaiflow / ExpiryGuard - Production Caddyfile
# Automatic HTTPS, TLS 1.3, HSTS, Rate Limiting & WebSocket Reverse Proxy

{
    # Global options
    email admin@dawaiflow.com
    admin off
    servers {
        protocol {
            experimental_http3
            strict_sni_host
        }
    }
}

api.dawaiflow.com, app.dawaiflow.com {
    # -------------------------------------------------------------
    # Production Security Headers & HSTS
    # -------------------------------------------------------------
    header {
        # HSTS: 2 years duration with subdomains and preload eligibility
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        # Clickjacking defense
        X-Frame-Options "DENY"
        # MIME type sniffing defense
        X-Content-Type-Options "nosniff"
        # Cross-Site Scripting defense
        X-XSS-Protection "1; mode=block"
        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy
        Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none';"
        # Permissions Policy
        Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
        # Hide server identity
        -Server
    }

    # -------------------------------------------------------------
    # Gzip & Zstandard Compression
    # -------------------------------------------------------------
    encode gzip zstd

    # -------------------------------------------------------------
    # Cloudflare / Trusted Proxy Real-IP Handling
    # -------------------------------------------------------------
    trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 172.16.0.0/12 10.0.0.0/8 127.0.0.1

    # -------------------------------------------------------------
    # Reverse Proxy to FastAPI Backend
    # -------------------------------------------------------------
    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # WebSocket support handled automatically by Caddy
        transport http {
            keepalive 30s
            compression off
        }
    }

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 5
        }
        format json
    }
}

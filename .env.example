# ==============================================================================
# EXPIRYGUARD ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure all variables securely.
# DO NOT commit real secrets or production .env files to source control!

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' on live servers (enforces Secure HTTPS cookies).
# Set to 'development' for local localhost testing.
ENVIRONMENT=development
PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTION (Supabase PostgreSQL / Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://[user]:[password]@[host]:[port]/[database]
# For production pooling, use port 6543 / 5432 with sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:<SUPABASE_PASSWORD>@db.zimiejrakfudnhztxpct.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECURITY KEYS (JWT Session Signing)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit key using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=01b30920ccc4f7edf51d8b9852900e2cbe3133517608cc10568e63dc803f084d

# ------------------------------------------------------------------------------
# 4. CORS DOMAIN WHITELIST
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (Do NOT use wildcard '*' when credentials are used)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Required for AI OCR / invoice & label scanning (Get key from Google AI Studio)
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MULTI_SCAN_MODEL=gemini-flash-latest
GEMINI_INVOICE_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (Optional - Redis / Upstash)
# ------------------------------------------------------------------------------
# If left unset or set to memory://, uses local in-memory rate limiting.
# For multi-worker production deployments, set this to your Redis URI:
# REDIS_URL=redis://default:token@your-redis-host:6379/0
REDIS_URL=memory://

# ------------------------------------------------------------------------------
# 7. FIREBASE CLOUD MESSAGING (FCM) SERVICE ACCOUNT
# ------------------------------------------------------------------------------
# Path to the Google Service Account JSON file (ensure file is in .gitignore)
FIREBASE_CREDENTIALS_PATH=credentials/firebase_key.json

# ------------------------------------------------------------------------------
# 8. INSTANT EMAIL NOTIFICATIONS (Gmail SMTP / Custom SMTP)
# ------------------------------------------------------------------------------
# Whenever a pharmacy owner requests pilot access, an immediate alert email is sent
# directly to the founder.
#
# HOW TO GET A GMAIL APP PASSWORD:
# 1. Open your Google Account (https://myaccount.google.com/)
# 2. Go to 'Security' -> Ensure '2-Step Verification' is turned ON.
# 3. Search for 'App passwords' or visit https://myaccount.google.com/apppasswords
# 4. App Name: "ExpiryGuard Notifications" -> Click 'Create'.
# 5. Copy the 16-character code (e.g. abcd efgh ijkl mnop) and paste below without spaces.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
MY_EMAIL=your_personal_receiving_email@gmail.com
SMTP_FROM_NAME="ExpiryGuard Pilot Alerts"
